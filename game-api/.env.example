# -- Groq Configuration --
GROQ_API_KEY=

# -- Comet Configuration --
COMET_API_KEY=

# -- Security & Admin Configuration --
ADMIN_USER=
ADMIN_KEY=
SECRET_KEY=
# Comma-separated. Must be the exact origin(s) the frontend is served from - CORS with cookies
# cannot use "*". Also checked against the websocket handshake's Origin header.
FRONTEND_ORIGINS=http://localhost:5173

# -- WestAI LLM Proxy Configuration (OpenAI proxy) --
WESTAI_API_KEY=

# -- MistralAI Proxy Configuration --
MISTRAL_API_KEY=

# -- PostgreSQL Configuration --
# Inside Docker these are overridden with the in-network host "postgres".
# The DB port is not published to the host by default; these values apply
# only if you run the API outside Docker against your own PostgreSQL.
POSTGRES_URI=postgresql+psycopg://mlops_labs:mlops_labs@localhost:5432/mlops_labs
POSTGRES_ASYNC_URI=postgresql+asyncpg://mlops_labs:mlops_labs@localhost:5432/mlops_labs

# -- HuggingFace Configuration --
HF_TOKEN=
HF_HUB_DISABLE_XET=1

# -- Admin graph debug view (docs/plans/graph-redesign/09-debug-view.md) --
# Off by default. Set to true to use the "graph debug" tab in the admin panel.
ENABLE_GRAPH_DEBUG=false

# -- Dossier answer key --
# Off by default, never on in production. Set to true to send the true tag, the real convincer
# archetype and the source artifact of every note with the dossier, shown behind a debug button.
ENABLE_DOSSIER_DEBUG=false

# -- Player account reset (docs/plans/player-settings-and-tts.md) --
# Off by default, never on in production. Set to true to let a player wipe their own account
# from the in-game settings panel and start over as a freshly registered user. This is the
# player-facing reset, not the admin "delete player" action, which is always available.
ENABLE_RESET_USER=false

# -- Playtest tools (docs/plans/results-screen.md) --
# Off by default, never on in production. Set to true to show "skip this challenge" and "auto-pitch
# a card" in the in-game settings panel, for manufacturing finished games while testing. Using either
# marks the account as a playtest account, which leaves every research aggregate in the admin panel.
ENABLE_PLAYTEST_TOOLS=false

# -- Dev accounts, no email required (docs/plans/password-auth.md) --
# Off by default, never on in production. Set to true to register every account as if it joined
# a test campaign: no email, no verification code, no password-length policy. Lets a local dev
# environment create throwaway accounts without SMTP configured or a test campaign set up first.
ENABLE_DEV_ACCOUNTS=false

# -- SMTP Email Configuration (RWTH mail relay, StartTLS) --
# Used to deliver registration/login email-verification codes and password-reset codes.
# Ask the project maintainers for the mailbox password - never commit it here.
SMTP_HOST=mail.rwth-aachen.de
SMTP_PORT=587
SMTP_USERNAME=fkt_mlops-labs@dbis.rwth-aachen.de
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mlops-labs@dbis.rwth-aachen.de
SMTP_USE_TLS=true
