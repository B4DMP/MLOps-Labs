# -- Groq Configuration --
GROQ_API_KEY=

# -- Comet Configuration --
COMET_API_KEY=

# -- Security & Admin Configuration --
ADMIN_USER=
ADMIN_KEY=
SECRET_KEY=

# -- WestAI LLM Proxy Configuration (OpenAI proxy) --
WESTAI_API_KEY=

# -- MistralAI Proxy Configuration --
MISTRAL_API_KEY=

# -- PostgreSQL Configuration --
# Inside Docker these are overridden with the in-network host "postgres".
# The DB port is not published to the host by default; these values apply
# only if you run the API outside Docker against your own PostgreSQL.
POSTGRES_URI=postgresql+psycopg://mlops_labs:mlops_labs@localhost:5432/mlops_labs
POSTGRES_ASYNC_URI=postgresql+asyncpg://mlops_labs:mlops_labs@localhost:5432/mlops_labs

# -- HuggingFace Configuration --
HF_TOKEN=
HF_HUB_DISABLE_XET=1

