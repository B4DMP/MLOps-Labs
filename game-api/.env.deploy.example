# Template for the `mlops-game-api-secrets` k8s Secret in the `mlops-lab` namespace.
# Copy to `.env.deploy` (gitignored), fill in real production values, then run:
#   kubectl create secret generic mlops-game-api-secrets -n mlops-lab --from-env-file=game-api/.env.deploy
# See docs/plans/k8s-redeploy-and-self-service-updates.md.
# Non-sensitive values (POSTGRES_URI, feature flags, SMTP host/port) live in
# manifests/configmap-game-api.yaml instead - don't duplicate them here.

# -- Security & Admin Configuration --
ADMIN_USER=
ADMIN_KEY=
SECRET_KEY=

# -- LLM provider keys --
GROQ_API_KEY=
OPENAI_API_KEY=
WESTAI_API_KEY=
MISTRAL_API_KEY=

# -- Comet ML / Opik --
COMET_API_KEY=

# -- Hugging Face --
HF_TOKEN=

# -- SMTP credentials (host/port/from-address are in the ConfigMap) --
SMTP_USERNAME=
SMTP_PASSWORD=
