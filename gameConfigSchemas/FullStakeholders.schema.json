{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Full Stakeholders Configuration",
  "required": ["stakeholders"],
  "properties": {
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "metric_id", "role_description", "responsibilities", "priorities", "requirements"],
        "properties": {
          "id": {
            "type": "string",
            "title": "Stakeholder ID",
            "enum": ["data_dave", "model_monica", "requirements_reuben", "efficiency_emilia", "automation_alex", "reliability_ruth"]
          },
          "name": {
            "type": "string",
            "title": "Full Name"
          },
          "metric_id": {
            "type": "string",
            "title": "Associated Metric ID",
            "enum": ["model", "automation", "reliability", "data", "requirements", "efficiency", "efficiency_intro", "model_intro"]
          },
          "role_description": {
            "type": "string",
            "title": "Role Description"
          },
          "responsibilities": {
            "type": "string",
            "title": "Responsibilities"
          },
          "priorities": {
            "type": "string",
            "title": "Priorities"
          },
          "requirements": {
            "type": "string",
            "title": "Requirements Summary"
          }
        }
      }
    }
  }
}
