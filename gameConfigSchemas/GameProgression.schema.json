{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Game Progression Configuration",
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "phase_introduction"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "title": "Phase ID"
          },
          "name": {
            "type": "string",
            "title": "Phase Name"
          },
          "description": {
            "type": "string",
            "title": "Phase Description"
          },
          "phase_introduction": {
            "type": "string",
            "title": "Phase Introduction"
          },
          "stakeholders": {
            "type": "array",
            "title": "Stakeholders",
            "items": {
              "type": "object",
              "required": [
                "stakeholder_id",
                "power",
                "interest"
              ],
              "properties": {
                "stakeholder_id": {
                  "type": "string",
                  "title": "Stakeholder ID",
                  "enum": [
                    "data_dave",
                    "model_monica",
                    "requirements_reuben",
                    "efficiency_emilia",
                    "automation_alex",
                    "reliability_ruth"
                  ]
                },
                "power": {
                  "type": "string",
                  "title": "Power Level",
                  "enum": [
                    "high",
                    "low"
                  ]
                },
                "interest": {
                  "type": "string",
                  "title": "Interest Level",
                  "enum": [
                    "high",
                    "low"
                  ]
                }
              }
            }
          },
          "challenges_per_phase": {
            "type": "integer",
            "minimum": 1,
            "title": "Challenges played per phase",
            "description": "Defaults to all challenges in the phase"
          }
        }
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase_id",
          "name",
          "description",
          "roundIntroduction",
          "metric_changes"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "title": "Challenge ID"
          },
          "phase_id": {
            "type": "integer",
            "title": "Phase ID"
          },
          "name": {
            "type": "string",
            "title": "Challenge Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "roundIntroduction": {
            "type": "string",
            "title": "Round Introduction"
          },
          "metric_changes": {
            "type": "object",
            "title": "Metric Changes Matrix"
          },
          "attention_tokens": {
            "type": "integer",
            "title": "Attention Tokens",
            "minimum": 0,
            "description": "Number of attention tokens granted to the player for this challenge"
          },
          "template_id": {
            "type": "string",
            "title": "Template ID",
            "description": "Stable content key, e.g. ch_data_quality_crisis"
          },
          "priority": {
            "type": "integer",
            "title": "Priority",
            "description": "Higher wins among eligible templates"
          },
          "preconditions": {
            "title": "Preconditions",
            "description": "Predicate over the MLOps graph (patterns, component and edge levels). true = always eligible"
          },
          "excluded_if": {
            "title": "Excluded if",
            "description": "Predicate that rules the challenge out"
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback",
            "description": "Exactly one per phase; picked when nothing else is eligible"
          },
          "repeatable": {
            "type": "boolean",
            "title": "Repeatable"
          },
          "on_enter_ops": {
            "type": "array",
            "title": "World events on start",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "raise_to",
                    "set_to",
                    "set_trigger",
                    "set_attr",
                    "instance_upsert"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "value": {},
                "attr": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "stalemate_ops": {
            "type": "array",
            "title": "World events on stalemate",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "raise_to",
                    "set_to",
                    "set_trigger",
                    "set_attr",
                    "instance_upsert"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "value": {},
                "attr": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "conflict": {
            "type": "object",
            "title": "Framing conflict",
            "required": [
              "type",
              "target",
              "positions"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "soft",
                  "hard"
                ]
              },
              "target": {
                "type": "string"
              },
              "positions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "stakeholder_id",
                    "wants"
                  ],
                  "properties": {
                    "stakeholder_id": {
                      "type": "string"
                    },
                    "wants": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    }
                  }
                }
              }
            }
          },
          "focus_stage_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "req",
                "data",
                "model",
                "deploy",
                "ops",
                "gov"
              ]
            }
          }
        }
      }
    },
    "ActionCardImages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "image"
        ],
        "properties": {
          "description": {
            "type": "string",
            "title": "Card Description"
          },
          "image": {
            "type": "string",
            "title": "Image Path"
          }
        }
      }
    }
  }
}
