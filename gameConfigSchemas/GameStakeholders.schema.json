{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Game Stakeholders Configuration",
  "required": [
    "stakeholders"
  ],
  "properties": {
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "metric_id",
          "role_description",
          "responsibilities",
          "priorities",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "Stakeholder ID",
            "enum": [
              "data_dave",
              "model_monica",
              "requirements_reuben",
              "efficiency_emilia",
              "automation_alex",
              "reliability_ruth"
            ]
          },
          "name": {
            "type": "string",
            "title": "Full Name"
          },
          "metric_id": {
            "type": "string",
            "title": "Associated Metric ID",
            "enum": [
              "model",
              "automation",
              "reliability",
              "data",
              "requirements",
              "efficiency",
              "efficiency_intro",
              "model_intro"
            ]
          },
          "role_description": {
            "type": "string",
            "title": "Role Description"
          },
          "introduction": {
            "type": "string",
            "title": "Self-Introduction (Phase Briefing Speech Bubble)",
            "description": "One or two friendly, human-sounding sentences the stakeholder says when introducing themselves at the start of a phase."
          },
          "responsibilities": {
            "type": "string",
            "title": "Responsibilities"
          },
          "priorities": {
            "type": "string",
            "title": "Priorities"
          },
          "requirements": {
            "type": "string",
            "title": "Requirements Summary"
          },
          "emotion_sensitivities": {
            "type": "object",
            "title": "Emotion Sensitivities",
            "description": "Dimensional sensitivity multipliers for pitch evaluation (defaults to 1.0)",
            "properties": {
              "trust": { "type": "number" },
              "fairness": { "type": "number" },
              "sense_of_control": { "type": "number" },
              "stress": { "type": "number" },
              "perceived_risk": { "type": "number" },
              "confidence": { "type": "number" },
              "interest": { "type": "number" }
            }
          },
          "avatar": {
            "type": "object",
            "title": "Stakeholder Avatar (Open Peeps)",
            "properties": {
              "head": {
                "type": "string",
                "title": "Head & Hair Style",
                "enum": [
                  "afro",
                  "bangs",
                  "bangs2",
                  "bantuKnots",
                  "bear",
                  "bun",
                  "bun2",
                  "buns",
                  "cornrows",
                  "cornrows2",
                  "dreads1",
                  "dreads2",
                  "flatTop",
                  "flatTopLong",
                  "grayBun",
                  "grayMedium",
                  "grayShort",
                  "hatBeanie",
                  "hatHip",
                  "hijab",
                  "long",
                  "longAfro",
                  "longBangs",
                  "longCurly",
                  "medium1",
                  "medium2",
                  "medium3",
                  "mediumBangs",
                  "mediumBangs2",
                  "mediumBangs3",
                  "mediumStraight",
                  "mohawk",
                  "mohawk2",
                  "noHair1",
                  "noHair2",
                  "noHair3",
                  "pomp",
                  "shaved1",
                  "shaved2",
                  "shaved3",
                  "short1",
                  "short2",
                  "short3",
                  "short4",
                  "short5",
                  "turban",
                  "twists",
                  "twists2"
                ]
              },
              "face": {
                "type": "string",
                "title": "Face Style",
                "enum": [
                  "angryWithFang",
                  "awe",
                  "blank",
                  "calm",
                  "cheeky",
                  "concerned",
                  "concernedFear",
                  "contempt",
                  "cute",
                  "cyclops",
                  "driven",
                  "eatingHappy",
                  "explaining",
                  "eyesClosed",
                  "fear",
                  "hectic",
                  "lovingGrin1",
                  "lovingGrin2",
                  "monster",
                  "old",
                  "rage",
                  "serious",
                  "smile",
                  "smileBig",
                  "smileLOL",
                  "smileTeethGap",
                  "solemn",
                  "suspicious",
                  "tired",
                  "veryAngry"
                ]
              },
              "emotion": {
                "type": "string",
                "title": "Emotion / Expression",
                "default": "smile",
                "enum": [
                  "angryWithFang",
                  "awe",
                  "blank",
                  "calm",
                  "cheeky",
                  "concerned",
                  "concernedFear",
                  "contempt",
                  "cute",
                  "cyclops",
                  "driven",
                  "eatingHappy",
                  "explaining",
                  "eyesClosed",
                  "fear",
                  "hectic",
                  "lovingGrin1",
                  "lovingGrin2",
                  "monster",
                  "old",
                  "rage",
                  "serious",
                  "smile",
                  "smileBig",
                  "smileLOL",
                  "smileTeethGap",
                  "solemn",
                  "suspicious",
                  "tired",
                  "veryAngry"
                ]
              },
              "facialHair": {
                "type": "string",
                "title": "Facial Hair Style",
                "enum": [
                  "chin",
                  "full",
                  "full2",
                  "full3",
                  "full4",
                  "goatee1",
                  "goatee2",
                  "moustache1",
                  "moustache2",
                  "moustache3",
                  "moustache4",
                  "moustache5",
                  "moustache6",
                  "moustache7",
                  "moustache8",
                  "moustache9"
                ]
              },
              "facialHairProbability": {
                "type": "integer",
                "title": "Facial Hair Probability (0-100)",
                "minimum": 0,
                "maximum": 100
              },
              "accessories": {
                "type": "string",
                "title": "Accessories / Eyewear",
                "enum": [
                  "eyepatch",
                  "glasses",
                  "glasses2",
                  "glasses3",
                  "glasses4",
                  "glasses5",
                  "sunglasses",
                  "sunglasses2"
                ]
              },
              "accessoriesProbability": {
                "type": "integer",
                "title": "Accessories Probability (0-100)",
                "minimum": 0,
                "maximum": 100
              },
              "skinColor": {
                "type": "string",
                "title": "Skin Color (Hex)",
                "enum": [
                  "ffdbb4",
                  "edb98a",
                  "d08b5b",
                  "ae5d29",
                  "694d3d"
                ]
              },
              "clothingColor": {
                "type": "string",
                "title": "Clothing Color (Hex)",
                "enum": [
                  "e78276",
                  "ffcf77",
                  "fdea6b",
                  "78e185",
                  "9ddadb",
                  "8fa7df",
                  "e279c7"
                ]
              },
              "headContrastColor": {
                "type": "string",
                "title": "Hair / Head Color (Hex)",
                "enum": [
                  "2c1b18",
                  "e8e1e1",
                  "ecdcbf",
                  "d6b370",
                  "f59797",
                  "b58143",
                  "a55728",
                  "724133",
                  "4a312c",
                  "c93305"
                ]
              },
              "backgroundColor": {
                "type": "string",
                "title": "Background Atmosphere / Color",
                "enum": [
                  "b6e3f4",
                  "c0aede",
                  "d1d4f9",
                  "ffd5dc",
                  "ffdfbf",
                  "transparent"
                ]
              },
              "flip": {
                "type": "boolean",
                "title": "Flip Horizontally"
              }
            },
            "description": "Role-level avatar defaults and the identity colors that stay the same whichever persona a player is dealt. Person-level traits belong on the persona."
          },
          "personas": {
            "type": "array",
            "title": "Personas",
            "description": "Interchangeable identities for this stakeholder. Each player is dealt one at the start of their game and keeps it throughout. Names must stay alliterative with the role word and keep the gender of the canonical persona, because the config prose refers to the stakeholder by pronoun.",
            "items": {
              "type": "object",
              "required": [
                "key",
                "name"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "title": "Persona Key",
                  "description": "Stable id stored on the player's session"
                },
                "name": {
                  "type": "string",
                  "title": "Full Name"
                },
                "avatar": {
                  "type": "object",
                  "title": "Persona Look (Open Peeps overrides)",
                  "properties": {
                    "head": {
                      "type": "string",
                      "title": "Head & Hair Style",
                      "enum": [
                        "afro",
                        "bangs",
                        "bangs2",
                        "bantuKnots",
                        "bear",
                        "bun",
                        "bun2",
                        "buns",
                        "cornrows",
                        "cornrows2",
                        "dreads1",
                        "dreads2",
                        "flatTop",
                        "flatTopLong",
                        "grayBun",
                        "grayMedium",
                        "grayShort",
                        "hatBeanie",
                        "hatHip",
                        "hijab",
                        "long",
                        "longAfro",
                        "longBangs",
                        "longCurly",
                        "medium1",
                        "medium2",
                        "medium3",
                        "mediumBangs",
                        "mediumBangs2",
                        "mediumBangs3",
                        "mediumStraight",
                        "mohawk",
                        "mohawk2",
                        "noHair1",
                        "noHair2",
                        "noHair3",
                        "pomp",
                        "shaved1",
                        "shaved2",
                        "shaved3",
                        "short1",
                        "short2",
                        "short3",
                        "short4",
                        "short5",
                        "turban",
                        "twists",
                        "twists2"
                      ]
                    },
                    "accessories": {
                      "type": "string",
                      "title": "Accessories / Eyewear",
                      "enum": [
                        "eyepatch",
                        "glasses",
                        "glasses2",
                        "glasses3",
                        "glasses4",
                        "glasses5",
                        "sunglasses",
                        "sunglasses2"
                      ]
                    },
                    "accessoriesProbability": {
                      "type": "integer",
                      "title": "Accessories Probability (0-100)",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "facialHair": {
                      "type": "string",
                      "title": "Facial Hair Style",
                      "enum": [
                        "chin",
                        "full",
                        "full2",
                        "full3",
                        "full4",
                        "goatee1",
                        "goatee2",
                        "moustache1",
                        "moustache2",
                        "moustache3",
                        "moustache4",
                        "moustache5",
                        "moustache6",
                        "moustache7",
                        "moustache8",
                        "moustache9"
                      ]
                    },
                    "facialHairProbability": {
                      "type": "integer",
                      "title": "Facial Hair Probability (0-100)",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "skinColor": {
                      "type": "string",
                      "title": "Skin Color (Hex)",
                      "enum": [
                        "ffdbb4",
                        "edb98a",
                        "d08b5b",
                        "ae5d29",
                        "694d3d"
                      ]
                    },
                    "headContrastColor": {
                      "type": "string",
                      "title": "Hair / Head Color (Hex)",
                      "enum": [
                        "2c1b18",
                        "e8e1e1",
                        "ecdcbf",
                        "d6b370",
                        "f59797",
                        "b58143",
                        "a55728",
                        "724133",
                        "4a312c",
                        "c93305"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
