{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Offline Intel Artifacts Configuration",
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_id",
          "challenge_id",
          "stakeholder_id",
          "artifact_type",
          "content",
          "wrong_descriptions",
          "is_known"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "Artifact ID"
          },
          "requirement_id": {
            "type": "string",
            "title": "Requirement ID"
          },
          "challenge_id": {
            "type": "integer",
            "title": "Challenge ID"
          },
          "stakeholder_id": {
            "type": [
              "string",
              "null"
            ],
            "title": "Stakeholder ID"
          },
          "stakeholder_name": {
            "type": "string",
            "title": "Stakeholder Name"
          },
          "stakeholder_role": {
            "type": "string",
            "title": "Stakeholder Role"
          },
          "artifact_type": {
            "type": "string",
            "title": "Artifact Type",
            "enum": [
              "architecture_note",
              "ci_log",
              "dashboard_snapshot",
              "document",
              "email",
              "incident_ticket",
              "meeting_notes",
              "runbook",
              "slack_message"
            ]
          },
          "content": {
            "type": "string",
            "title": "Artifact Content"
          },
          "wrong_descriptions": {
            "type": "object",
            "title": "What a player with each wrong tag reads",
            "properties": {
              "driver": {
                "type": "string",
                "title": "Wrong description (Driver)"
              },
              "boundary": {
                "type": "string",
                "title": "Wrong description (Boundary)"
              },
              "trade_off": {
                "type": "string",
                "title": "Wrong description (Trade Off)"
              },
              "fact": {
                "type": "string",
                "title": "Wrong description (Fact)"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "is_known": {
            "type": "boolean",
            "title": "Is Known by Start of Round",
            "description": "Describes if an intel item is known by the start of the round."
          }
        }
      }
    }
  }
}
