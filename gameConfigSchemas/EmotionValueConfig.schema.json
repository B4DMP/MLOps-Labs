{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Emotion Values & CME Configuration",
  "required": [
    "emotion_values",
    "emotion_prompts",
    "emotional_states"
  ],
  "properties": {
    "emotion_values": {
      "type": "array",
      "title": "Emotion Value Dimensions",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "ge",
          "le"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "Dimension ID"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "ge": {
            "type": "number",
            "title": "Minimum Value (ge)",
            "default": 0.0
          },
          "le": {
            "type": "number",
            "title": "Maximum Value (le)",
            "default": 1.0
          }
        }
      }
    },
    "emotion_prompts": {
      "type": "object",
      "title": "Emotion Character Prompts",
      "additionalProperties": {
        "type": "string"
      }
    },
    "emotional_states": {
      "type": "object",
      "title": "Emotional States Configuration",
      "additionalProperties": {
        "$ref": "#/definitions/emotionalStateRule"
      }
    },
    "emotion_colors": {
      "type": "object",
      "title": "Emotion Colors",
      "additionalProperties": {
        "type": "string"
      }
    },
    "convincer_archetypes": {
      "type": "object",
      "title": "Convincer Archetypes",
      "additionalProperties": {
        "$ref": "#/definitions/convincerArchetype"
      }
    },
    "emotion_delta_rules": {
      "$ref": "#/definitions/emotionDeltaRules"
    },
    "pitch_tuning": {
      "$ref": "#/definitions/pitchTuning"
    }
  },
  "definitions": {
    "pitchTuning": {
      "type": "object",
      "title": "Pitch Tuning (D38)",
      "description": "Tuning numbers for the merged pitch phase: dialogue-option emotion effects, veto/objection thresholds, and grudge lifetime. All optional - omitted fields fall back to the pre-D38 hardcoded values.",
      "properties": {
        "emotion_stonewall": { "type": "number", "title": "Stonewall: hit to the objecting stakeholder", "default": -0.10 },
        "emotion_stonewall_ally": { "type": "number", "title": "Stonewall: gain to the opposing side", "default": 0.05 },
        "emotion_reframe": { "type": "number", "title": "Reframe: gain to the objecting stakeholder", "default": 0.02 },
        "emotion_addendum": { "type": "number", "title": "Emergency Addendum: hit to the objecting stakeholder", "default": -0.15 },
        "emotion_concede": { "type": "number", "title": "Concede Correction: hit to the objecting stakeholder", "default": -0.05 },
        "emotion_veto_breaker": { "type": "number", "title": "Veto Breaker: hit to the overridden stakeholder", "default": -0.40 },
        "emotion_concede_win": { "type": "number", "title": "Let Them Have It (D41): gain to the side that gets its way", "default": 0.30 },
        "emotion_concede_lose": { "type": "number", "title": "Let Them Have It (D41): hit to the side whose card was dropped", "default": -0.20 },
        "secondary_malus": { "type": "number", "title": "Fit penalty vs. a stakeholder's secondary archetype", "default": 0.15 },
        "veto_threshold": { "type": "number", "title": "Buy-in floor below which a high-power stakeholder vetoes", "default": 0.4 },
        "objection_threshold": { "type": "number", "title": "Buy-in floor below which a low-power stakeholder objects", "default": 0.3 },
        "loss_w": { "type": "number", "title": "Weight of accumulated loss in the buy-in formula", "default": 0.3 },
        "grudge_lifetime": { "type": "integer", "title": "Simulations a grudge keeps firing before it is spent", "default": 2 },
        "reframe_hit": { "type": "number", "title": "Fit at/above this on Reframe is a Direct Hit (D48)", "default": 0.7 },
        "reframe_partial": { "type": "number", "title": "Fit at/above this (below Hit) on Reframe is a Partial (D48)", "default": 0.4 },
        "room_listen": { "type": "number", "title": "Fit below which other high-power seats turn colder on a Reframe (D48)", "default": 0.35 },
        "emotion_reframe_miss": { "type": "number", "title": "Reframe Miss: hit to the objecting stakeholder, now hardened", "default": -0.08 },
        "emotion_room_listening": { "type": "number", "title": "Reframe: hit to other high-power seats with a poor fit", "default": -0.03 },
        "default_patience": { "type": "integer", "title": "Patience per stakeholder per challenge (D50)", "default": 3 },
        "sound_out_patience_cost": { "type": "integer", "title": "Patience spent sounding a stakeholder out in Build your case (D50)", "default": 1 },
        "emotion_refuted": { "type": "number", "title": "Gather Test a hypothesis: trust hit on Refuted (D49)", "default": -0.05 },
        "emotion_trial_balloon_match": { "type": "number", "title": "Gather Trial Balloon: gain on a match (D49)", "default": 0.05 },
        "emotion_trial_balloon_miss": { "type": "number", "title": "Gather Trial Balloon: hit on a ruled-out guess (D49)", "default": -0.03 },
        "emotion_one_on_one_miss": { "type": "number", "title": "Gather 1-on-1 template: hit on a wrong pair (D49)", "default": -0.05 }
      }
    },
    "emotionDeltaRules": {
      "type": "object",
      "title": "Emotion Delta Rules",
      "properties": {
        "intel_rules": {
          "type": "object",
          "title": "Intel Delta Rules",
          "properties": {
            "misattributed_intel": {
              "type": "object",
              "title": "Misattributed Intel Penalties",
              "additionalProperties": {
                "type": "number"
              }
            },
            "correct_intel": {
              "type": "object",
              "title": "Correct Intel Rewards",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "corporate_noise_rules": {
          "type": "object",
          "title": "Corporate Noise Delta Rules",
          "properties": {
            "distance_threshold": {
              "type": "number",
              "title": "Distance Threshold",
              "default": 3.5
            },
            "distance_slope": {
              "type": "number",
              "title": "Distance Slope",
              "default": 0.04
            },
            "base_trust_bonus": {
              "type": "number",
              "title": "Base Trust Bonus",
              "default": 0.10
            },
            "base_trust_penalty": {
              "type": "number",
              "title": "Base Trust Penalty",
              "default": -0.10
            },
            "dimension_alignments": {
              "type": "array",
              "title": "Dimension Alignments",
              "items": {
                "type": "object",
                "required": [
                  "dimension",
                  "conditions"
                ],
                "properties": {
                  "dimension": {
                    "type": "string",
                    "title": "Dimension Name"
                  },
                  "conditions": {
                    "type": "array",
                    "title": "Conditions",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "deltas"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "title": "Condition Type",
                          "enum": [
                            "option_min",
                            "diff_bonus",
                            "diff_penalty"
                          ]
                        },
                        "min_value": {
                          "type": "integer",
                          "title": "Minimum Value"
                        },
                        "target_min_value": {
                          "type": "integer",
                          "title": "Target Minimum Value"
                        },
                        "min_diff": {
                          "type": "integer",
                          "title": "Minimum Difference"
                        },
                        "max_diff": {
                          "type": "integer",
                          "title": "Maximum Difference"
                        },
                        "deltas": {
                          "type": "object",
                          "title": "Emotional Deltas",
                          "additionalProperties": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "emotionalStateRule": {
      "type": "object",
      "title": "State Rule",
      "required": [
        "conditions",
        "formula"
      ],
      "properties": {
        "facial_expression": {
          "type": "string",
          "title": "Avatar Facial Expression",
          "default": "smile"
        },
        "color": {
          "type": "string",
          "title": "Hex Color Code"
        },
        "conditions": {
          "type": "array",
          "title": "Trigger Conditions",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "op",
              "value"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "title": "Metric ID"
              },
              "op": {
                "type": "string",
                "title": "Operator",
                "enum": [
                  "<=",
                  ">=",
                  "<",
                  ">",
                  "=="
                ]
              },
              "value": {
                "type": "number",
                "title": "Threshold Value"
              }
            }
          }
        },
        "formula": {
          "type": "object",
          "title": "Intensity Formula",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "title": "Formula Type",
              "enum": [
                "weighted_sum",
                "constant"
              ]
            },
            "value": {
              "type": "number",
              "title": "Constant Value"
            },
            "weights": {
              "type": "array",
              "title": "Weights",
              "items": {
                "type": "object",
                "required": [
                  "metric",
                  "weight"
                ],
                "properties": {
                  "metric": {
                    "type": "string",
                    "title": "Metric ID"
                  },
                  "weight": {
                    "type": "number",
                    "title": "Weight"
                  },
                  "invert": {
                    "type": "boolean",
                    "title": "Invert (1.0 - value)",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "convincerArchetype": {
      "type": "object",
      "title": "Convincer Archetype",
      "required": [
        "evidence_basis",
        "risk_and_control",
        "value_horizon",
        "strategy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Archetype Name"
        },
        "label": {
          "type": "string",
          "title": "Archetype Display Label"
        },
        "icon": {
          "type": "string",
          "title": "Archetype Icon/Emoji"
        },
        "color": {
          "type": "string",
          "title": "Archetype Color (Hex)"
        },
        "evidence_basis": {
          "type": "integer",
          "title": "Evidence Basis (0=Rational -> 5=Relational)",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "risk_and_control": {
          "type": "integer",
          "title": "Risk & Control (0=Autonomy/Risk-tolerant -> 5=Control/Risk-averse)",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "value_horizon": {
          "type": "integer",
          "title": "Value Horizon (0=Short-term Practical -> 5=Long-term Strategic)",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "strategy": {
          "type": "string",
          "title": "Persuasion Strategy"
        }
      }
    }
  }
}
