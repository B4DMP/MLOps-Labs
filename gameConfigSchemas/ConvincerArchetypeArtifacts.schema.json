{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConvincerArchetypeArtifacts",
  "type": "object",
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "archetype",
          "artifact_type",
          "convincer_archetype_artifact"
        ],
        "properties": {
          "archetype": {
            "type": "string",
            "enum": [
              "Technical Excellence",
              "Business Value",
              "Safety & Reliability",
              "Control & Governance",
              "People & Trust",
              "Autonomy",
              "Pragmatism"
            ]
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "email",
              "slack_message",
              "meeting_notes",
              "document"
            ]
          },
          "convincer_archetype_artifact": {
            "type": "string",
            "description": "Short workplace communication artifact template containing {stakeholder_name} placeholder."
          }
        }
      }
    }
  }
}
